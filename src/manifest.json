{
  "manifest_version": 3,
  "name": "RJ AIO Metadata — Microstock AI Assistant",
  "version": "0.1.0",
  "description": "All-in-one AI metadata generator and auto-fill assistant for microstock contributor dashboards.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.stock.adobe.com/*",
    "*://*.shutterstock.com/*",
    "*://*.dreamstime.com/*",
    "*://*.vecteezy.com/*",
    "*://*.freepik.com/*",
    "*://*.depositphotos.com/*",
    "*://*.miricanvas.com/*",
    "https://*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RJ AIO Metadata Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://contributor.stock.adobe.com/*",
        "*://submit.shutterstock.com/*",
        "*://*.dreamstime.com/*",
        "*://contributors.vecteezy.com/*",
        "*://contributor.freepik.com/*",
        "*://*.depositphotos.com/*",
        "*://designhub.miricanvas.com/*"
      ],
      "js": ["content/content_main.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay/*",
        "styles/*",
        "icons/*"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}
